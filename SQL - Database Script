-- Create the database
CREATE DATABASE RaceDayDB;
GO

USE RaceDayDB;
GO

-- ============================================================
-- TABLE: Users
-- Stores all user accounts for the RaceDay system
-- Both Organisers and Participants are stored here
-- ============================================================
CREATE TABLE Users (
    UserID INT IDENTITY(1,1) PRIMARY KEY,
    Email NVARCHAR(255) NOT NULL UNIQUE,
    PasswordHash NVARCHAR(500) NOT NULL,
    FirstName NVARCHAR(100) NOT NULL,
    LastName NVARCHAR(100) NOT NULL,
    Phone NVARCHAR(50) NULL,
    Role NVARCHAR(20) NOT NULL CHECK (Role IN ('Organiser', 'Participant')),
    ProfilePictureUrl NVARCHAR(500) NULL,
    CreatedAt DATETIME2 DEFAULT GETDATE(),
    UpdatedAt DATETIME2 NULL
);
GO

-- ============================================================
-- TABLE: Organisers
-- Extends Users with organiser-specific information
-- ============================================================
CREATE TABLE Organisers (
    OrganiserID INT IDENTITY(1,1) PRIMARY KEY,
    UserID INT NOT NULL UNIQUE,
    OrganisationName NVARCHAR(255) NULL,
    Website NVARCHAR(255) NULL,
    Verified BIT DEFAULT 0,
    FOREIGN KEY (UserID) REFERENCES Users(UserID) ON DELETE CASCADE
);
GO

-- ============================================================
-- TABLE: Participants
-- Extends Users with participant-specific information
-- ============================================================
CREATE TABLE Participants (
    ParticipantID INT IDENTITY(1,1) PRIMARY KEY,
    UserID INT NOT NULL UNIQUE,
    DateOfBirth DATE NULL,
    Gender NVARCHAR(20) NULL CHECK (Gender IN ('Male', 'Female', 'Other')),
    EmergencyContact NVARCHAR(100) NULL,
    EmergencyPhone NVARCHAR(50) NULL,
    MedicalConditions NVARCHAR(500) NULL,
    FOREIGN KEY (UserID) REFERENCES Users(UserID) ON DELETE CASCADE
);
GO

-- ============================================================
-- TABLE: Events
-- Stores all event details created by Organisers
-- ============================================================
CREATE TABLE Events (
    EventID INT IDENTITY(1,1) PRIMARY KEY,
    OrganiserID INT NOT NULL,
    Name NVARCHAR(255) NOT NULL,
    Description NVARCHAR(1000) NULL,
    Date DATETIME2 NOT NULL,
    Location NVARCHAR(500) NOT NULL,
    Distance DECIMAL(10,2) NOT NULL,
    EventType NVARCHAR(20) NOT NULL CHECK (EventType IN ('Run', 'Walk', 'Cycle')),
    BannerImageUrl NVARCHAR(500) NULL,
    IsActive BIT DEFAULT 1,
    MaxParticipants INT NULL,
    CreatedAt DATETIME2 DEFAULT GETDATE(),
    UpdatedAt DATETIME2 NULL,
    FOREIGN KEY (OrganiserID) REFERENCES Organisers(OrganiserID)
);
GO

-- ============================================================
-- TABLE: Categories
-- Defines categories (age groups or distance groups) for events
-- ============================================================
CREATE TABLE Categories (
    CategoryID INT IDENTITY(1,1) PRIMARY KEY,
    Name NVARCHAR(100) NOT NULL,
    Description NVARCHAR(255) NULL,
    AgeMin INT NULL,
    AgeMax INT NULL,
    Distance DECIMAL(10,2) NULL,
    CreatedAt DATETIME2 DEFAULT GETDATE()
);
GO

-- ============================================================
-- TABLE: EventCategories
-- Junction table for many-to-many relationship between Events and Categories
-- ============================================================
CREATE TABLE EventCategories (
    EventCategoryID INT IDENTITY(1,1) PRIMARY KEY,
    EventID INT NOT NULL,
    CategoryID INT NOT NULL,
    FOREIGN KEY (EventID) REFERENCES Events(EventID) ON DELETE CASCADE,
    FOREIGN KEY (CategoryID) REFERENCES Categories(CategoryID) ON DELETE CASCADE,
    CONSTRAINT UQ_EventCategory UNIQUE (EventID, CategoryID)
);
GO

-- ============================================================
-- TABLE: Enrolments
-- Records participant registrations for events
-- ============================================================
CREATE TABLE Enrolments (
    EnrolmentID INT IDENTITY(1,1) PRIMARY KEY,
    ParticipantID INT NOT NULL,
    EventID INT NOT NULL,
    CategoryID INT NOT NULL,
    Status NVARCHAR(20) DEFAULT 'Pending' CHECK (Status IN ('Pending', 'Confirmed', 'Cancelled')),
    EnrolmentDate DATETIME2 DEFAULT GETDATE(),
    Notes NVARCHAR(500) NULL,
    FOREIGN KEY (ParticipantID) REFERENCES Participants(ParticipantID),
    FOREIGN KEY (EventID) REFERENCES Events(EventID),
    FOREIGN KEY (CategoryID) REFERENCES Categories(CategoryID),
    CONSTRAINT UQ_Enrolment UNIQUE (ParticipantID, EventID)
);
GO

-- ============================================================
-- TABLE: Results
-- Stores finish times and positions for participants
-- ============================================================
CREATE TABLE Results (
    ResultID INT IDENTITY(1,1) PRIMARY KEY,
    EnrolmentID INT NOT NULL UNIQUE,
    FinishTime TIME NULL,
    FinishPosition INT NULL,
    Status NVARCHAR(20) DEFAULT 'DNS' CHECK (Status IN ('DNS', 'DNF', 'Finished')),
    Notes NVARCHAR(500) NULL,
    RecordedAt DATETIME2 DEFAULT GETDATE(),
    FOREIGN KEY (EnrolmentID) REFERENCES Enrolments(EnrolmentID) ON DELETE CASCADE
);
GO

-- ============================================================
-- INDEXES
-- Optimise query performance
-- ============================================================
CREATE INDEX IX_Events_Date ON Events(Date);
CREATE INDEX IX_Events_OrganiserID ON Events(OrganiserID);
CREATE INDEX IX_Events_EventType ON Events(EventType);
CREATE INDEX IX_Enrolments_ParticipantID ON Enrolments(ParticipantID);
CREATE INDEX IX_Enrolments_EventID ON Enrolments(EventID);
CREATE INDEX IX_Enrolments_Status ON Enrolments(Status);
CREATE INDEX IX_Results_EnrolmentID ON Results(EnrolmentID);
CREATE INDEX IX_Users_Email ON Users(Email);
