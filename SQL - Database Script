-- Common operations
-- ============================================================

-- Get all events with enrolment counts for a specific organiser
CREATE PROCEDURE GetOrganiserEvents
    @OrganiserID INT
AS
BEGIN
    SELECT 
        e.EventID,
        e.Name,
        e.Date,
        e.Location,
        e.EventType,
        e.MaxParticipants,
        COUNT(en.EnrolmentID) AS CurrentEnrolments,
        (e.MaxParticipants - COUNT(en.EnrolmentID)) AS AvailableSlots
    FROM Events e
    LEFT JOIN Enrolments en ON e.EventID = en.EventID
    WHERE e.OrganiserID = @OrganiserID
    GROUP BY e.EventID, e.Name, e.Date, e.Location, e.EventType, e.MaxParticipants
    ORDER BY e.Date;
END;
GO

-- Enrol a participant in an event
CREATE PROCEDURE EnrolParticipant
    @ParticipantID INT,
    @EventID INT,
    @CategoryID INT,
    @EnrolmentID INT OUTPUT
AS
BEGIN
    BEGIN TRANSACTION;
    
    -- Check if event is full
    DECLARE @MaxParticipants INT;
    DECLARE @CurrentEnrolments INT;
    
    SELECT @MaxParticipants = MaxParticipants FROM Events WHERE EventID = @EventID;
    SELECT @CurrentEnrolments = COUNT(*) FROM Enrolments WHERE EventID = @EventID;
    
    IF @MaxParticipants IS NOT NULL AND @CurrentEnrolments >= @MaxParticipants
    BEGIN
        ROLLBACK;
        THROW 50000, 'Event is full', 1;
    END;
    
    -- Check if participant is already enrolled
    IF EXISTS (SELECT 1 FROM Enrolments WHERE ParticipantID = @ParticipantID AND EventID = @EventID)
    BEGIN
        ROLLBACK;
        THROW 50001, 'Participant already enrolled in this event', 1;
    END;
    
    -- Insert the enrolment
    INSERT INTO Enrolments (ParticipantID, EventID, CategoryID, Status)
    VALUES (@ParticipantID, @EventID, @CategoryID, 'Pending');
    
    SET @EnrolmentID = SCOPE_IDENTITY();
    
    COMMIT;
END;
GO

-- ============================================================
-- TRIGGERS
-- Automatically create a Result record when an enrolment is completed
-- ============================================================

CREATE TRIGGER trg_EnrolmentStatus_To_Result
ON Enrolments
AFTER UPDATE
AS
BEGIN
    IF UPDATE(Status)
    BEGIN
        INSERT INTO Results (EnrolmentID, Status)
        SELECT 
            i.EnrolmentID,
            CASE 
                WHEN i.Status = 'Confirmed' THEN 'DNS'
                WHEN i.Status = 'Cancelled' THEN 'DNS'
                ELSE 'DNS'
            END
        FROM inserted i
        JOIN deleted d ON i.EnrolmentID = d.EnrolmentID
        WHERE i.Status IN ('Confirmed', 'Cancelled')
        AND d.Status NOT IN ('Confirmed', 'Cancelled')
        AND NOT EXISTS (SELECT 1 FROM Results WHERE EnrolmentID = i.EnrolmentID);
    END;
END;
