-- Create useful views for reporting
-- ============================================================

-- View: EventSummary - Shows event details with enrolment and result counts
CREATE VIEW EventSummary AS
SELECT 
    e.EventID,
    e.Name AS EventName,
    e.Date,
    e.Location,
    e.EventType,
    u.FirstName + ' ' + u.LastName AS OrganiserName,
    COUNT(DISTINCT en.EnrolmentID) AS TotalEnrolments,
    COUNT(DISTINCT r.ResultID) AS TotalResults,
    e.MaxParticipants
FROM Events e
JOIN Organisers o ON e.OrganiserID = o.OrganiserID
JOIN Users u ON o.UserID = u.UserID
LEFT JOIN Enrolments en ON e.EventID = en.EventID
LEFT JOIN Results r ON en.EnrolmentID = r.EnrolmentID
GROUP BY e.EventID, e.Name, e.Date, e.Location, e.EventType, u.FirstName, u.LastName, e.MaxParticipants;
GO

-- View: ParticipantResults - Shows participant results with rankings
CREATE VIEW ParticipantResults AS
SELECT 
    p.ParticipantID,
    u.FirstName + ' ' + u.LastName AS ParticipantName,
    e.Name AS EventName,
    e.Date AS EventDate,
    c.Name AS CategoryName,
    r.FinishTime,
    r.FinishPosition,
    r.Status,
    (SELECT COUNT(*) + 1 FROM Results r2 
     WHERE r2.FinishPosition < r.FinishPosition 
       AND r2.Status = 'Finished') AS OverallRanking
FROM Results r
JOIN Enrolments en ON r.EnrolmentID = en.EnrolmentID
JOIN Participants p ON en.ParticipantID = p.ParticipantID
JOIN Users u ON p.UserID = u.UserID
JOIN Events e ON en.EventID = e.EventID
JOIN Categories c ON en.CategoryID = c.CategoryID
WHERE r.Status = 'Finished';
GO

